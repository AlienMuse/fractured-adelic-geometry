/-
  BSD/FractureDiagram.lean

  The arithmetic fracture diagram I_ar of Chapter 7
  (Definition "the arithmetic fracture diagram", `defn:ch07-fracture-diagram`)
  as an explicit indexing category.

  UNCHECKED.  Not compiled; see BSD/Basic.lean and README.md.
-/

import Mathlib.Order.Basic
import Mathlib.CategoryTheory.Category.Basic
import BSD.Basic

namespace BSD

/--
The objects of the arithmetic fracture diagram `I_ar`
(Chapter 7, `defn:ch07-fracture-diagram`).

* `eta`            -- the generic vertex: the rational fibre, enhanced to a
                      condensed analytic stack over `Q`.  Sees the rational
                      motive and the Galois action; nothing integral.
* `infty`          -- the archimedean vertex: the real analytic stack with its
                      real Hodge structure and Deligne complex.  Sees periods,
                      the regulator, the Gamma-factor and the sign at infinity.
                      It is the only vertex with no Frobenius, and it is a leaf.
* `prism p`        -- the prismatic vertex at `p`: the Bhatt--Lurie/Drinfeld
                      prismatisation with its Frobenius and Nygaard filtration.
* `hodgeTate p`    -- the Hodge--Tate vertex at `p`: the Hodge--Tate locus
                      inside the prismatisation.  A boundary, not an
                      independent geometry.
* `analytic p`     -- the analytic vertex at `p`: the diamond over `Q_p`.
* `fargFont p`     -- the Fargues--Fontaine vertex at `p`: a bundle with
                      modification on the Fargues--Fontaine curve.  This is the
                      vertex at which the generic and the p-adic information
                      are required to agree.

The book indexes the last four by an arbitrary prime `p`.  Here `p : Nat`,
because Lean's `Nat` is what a finite-set-of-primes truncation will actually
range over; primality is *not* enforced by the type.  That is a deliberate
weakening and it is recorded as a discrepancy in the README.
-/
inductive ArVertex where
  | eta
  | infty
  | prism (p : Nat)
  | hodgeTate (p : Nat)
  | fargFont (p : Nat)
  | analytic (p : Nat)
  deriving DecidableEq, Repr

namespace ArVertex

/-- The prime a vertex is attached to, if any.  `eta` and `infty` are global. -/
def prime : ArVertex → Option Nat
  | eta          => none
  | infty        => none
  | prism p      => some p
  | hodgeTate p  => some p
  | fargFont p   => some p
  | analytic p   => some p

/-- Chapter 7: the archimedean vertex is the only one with no Frobenius. -/
def hasFrobenius : ArVertex → Bool
  | eta          => true
  | infty        => false
  | prism _      => true
  | hodgeTate _  => true
  | fargFont _   => true
  | analytic _   => true

theorem hasFrobenius_infty : hasFrobenius infty = false := rfl

theorem hasFrobenius_prism (p : Nat) : hasFrobenius (prism p) = true := rfl

end ArVertex

/--
The order relation of `I_ar`, generated by the five relations displayed in
Chapter 7:

    prism p <= hodgeTate p,   prism p <= analytic p,
    analytic p <= fargFont p, eta <= fargFont p,   eta <= infty.

Reflexivity and transitivity are taken as *constructors* rather than proved,
so that `ArLe` is a preorder by construction and no induction is needed to see
it.  The price is that `ArLe` is presented, not decided: the statement that it
generates no relations beyond the ones the book lists is an obligation below.
-/
inductive ArLe : ArVertex → ArVertex → Prop where
  | refl (x : ArVertex) : ArLe x x
  | trans {x y z : ArVertex} : ArLe x y → ArLe y z → ArLe x z
  | prism_hodgeTate (p : Nat) : ArLe (ArVertex.prism p) (ArVertex.hodgeTate p)
  | prism_analytic (p : Nat) : ArLe (ArVertex.prism p) (ArVertex.analytic p)
  | analytic_fargFont (p : Nat) : ArLe (ArVertex.analytic p) (ArVertex.fargFont p)
  | eta_fargFont (p : Nat) : ArLe ArVertex.eta (ArVertex.fargFont p)
  | eta_infty : ArLe ArVertex.eta ArVertex.infty

/-- The only nontrivial composite the book records: `prism p <= fargFont p`. -/
theorem ArLe.prism_fargFont (p : Nat) :
    ArLe (ArVertex.prism p) (ArVertex.fargFont p) :=
  ArLe.trans (ArLe.prism_analytic p) (ArLe.analytic_fargFont p)

instance : Preorder ArVertex where
  le := ArLe
  le_refl := ArLe.refl
  le_trans := fun _ _ _ h h' => ArLe.trans h h'

/--
`I_ar` is a poset, not merely a preorder: between any two elements there is at
most one relation, and antisymmetry holds.  Chapter 7 asserts this in one line
("the free category on the graph is indeed a poset").  A Lean proof requires an
inversion analysis of `ArLe`, which is routine but long; it is left as an
obligation rather than faked.
-/
theorem ArLe.antisymm {x y : ArVertex} (h : ArLe x y) (h' : ArLe y x) : x = y := by
  -- OBLIGATION: obl-ar-antisymm
  sorry

/--
The generic vertex does not map to the prismatic vertex: the generic fibre
carries no integral p-adic structure, and the Fargues--Fontaine vertex exists
precisely to carry the comparison instead (Chapter 7, the discussion after the
definition of the diagram).  Recording this as a *provable* statement about
`ArLe` is what makes the inductive presentation faithful; the proof is again an
inversion argument.
-/
theorem ArLe.eta_not_le_prism (p : Nat) : ¬ ArLe ArVertex.eta (ArVertex.prism p) := by
  -- OBLIGATION: obl-ar-eta-not-prism
  sorry

/--
`I_ar` as a category.

CHOICE MADE, AND WHY.  The specification offered two options: a genuine
`CategoryTheory.Category` instance, or a `Quiver` plus a hand-rolled
composition with the coherence axiomatised.  We take the first, because for a
*poset* the coherence is free: hom-types are `PLift` of a `Prop`, so any two
parallel morphisms are equal by proof irrelevance and the three category laws
are `rfl`.  Nothing delicate is being asserted.  The one thing we do not do is
route through Mathlib's preorder-to-category instance, whose exact name we
cannot check here; the instance is written out by hand instead.
-/
instance arSmallCategory : CategoryTheory.SmallCategory ArVertex where
  Hom x y := PLift (ArLe x y)
  id x := ⟨ArLe.refl x⟩
  comp f g := ⟨ArLe.trans f.down g.down⟩
  id_comp _ := rfl
  comp_id _ := rfl
  assoc _ _ _ _ := rfl

/--
The full subdiagram on `{eta, infty}` together with the four vertices attached
to each prime in a finite set `S`.  Chapter 7 writes this `I_ar^{(S)}`; it is
the truncation any actual computation would use.
-/
def inFiniteLevel (S : List Nat) : ArVertex → Bool
  | ArVertex.eta          => true
  | ArVertex.infty        => true
  | ArVertex.prism p      => S.contains p
  | ArVertex.hodgeTate p  => S.contains p
  | ArVertex.fargFont p   => S.contains p
  | ArVertex.analytic p   => S.contains p

theorem inFiniteLevel_eta (S : List Nat) : inFiniteLevel S ArVertex.eta = true := rfl

theorem inFiniteLevel_infty (S : List Nat) : inFiniteLevel S ArVertex.infty = true := rfl

/--
The four vertices attached to a single prime, in the order in which Chapter 7
lists them.  Used only for enumeration and printing.
-/
def verticesAt (p : Nat) : List ArVertex :=
  [ArVertex.prism p, ArVertex.hodgeTate p, ArVertex.analytic p, ArVertex.fargFont p]

theorem verticesAt_length (p : Nat) : (verticesAt p).length = 4 := rfl

end BSD
